# Salin ke .env.local lalu isi. Jangan pernah commit nilai asli.
# Buat secret acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Panitia: PIN acara 6 digit, diverifikasi di server (kosong = login panitia nonaktif)
EVENT_PIN=

# Tanda tangan QR tiket (HMAC), min. 32 karakter acak
TICKET_HMAC_SECRET=

# Cookie sesi panitia (HMAC), min. 32 karakter acak
SESSION_SECRET=

# Opsional: origin tetap untuk link tamu (mis. https://hmd.vercel.app). Kosong = host request.
APP_URL=

# Deploy (Vercel): data disimpan di Supabase kalau dua variabel ini diisi; kosong = file lokal
# .data/store.json. Ambil dari Supabase → Project Settings → API (service_role / secret key,
# hanya di server — jangan pakai prefix NEXT_PUBLIC_). Tabel: jalankan supabase/schema.sql sekali.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
