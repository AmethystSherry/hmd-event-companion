# Salin ke .env.local lalu isi. Jangan pernah commit nilai asli.
# Buat secret acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Panitia: PIN acara 6 digit, diverifikasi di server (kosong = login panitia nonaktif)
EVENT_PIN=

# Token link tamu /t/{token} (HMAC), min. 32 karakter acak. Ganti = semua link lama tidak berlaku.
GUEST_TOKEN_SECRET=

# Tanda tangan QR tiket (HMAC), min. 32 karakter acak
TICKET_HMAC_SECRET=

# Cookie sesi panitia (HMAC), min. 32 karakter acak
SESSION_SECRET=

# Claude (Phase 7, opsional): hanya dipakai dari server
ANTHROPIC_API_KEY=
